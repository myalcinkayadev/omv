#!/usr/bin/env bash
# omv: one command for the whole setup.
#   omv install [--no-setup] [--dry-run] [--no-apps]   install, shown step by step in omv Setup
#   omv update                            pull, install, relink, migrate, reload, then check
#   omv update --undo                     go back to the commit before the last update
#   omv doctor [--fix]                    check the setup, and clear a jam with --fix
#   omv uninstall [...]                   remove omv (see uninstall.sh)
#   omv setup                             walk through the macOS permissions omv needs
#   omv reload                            apply ~/.config/omv: rebuild aerospace.toml, reload apps
#   omv reload aerospace                  rebuild aerospace.toml and reload AeroSpace only
#   omv flags [<name> on|off]             list feature flags, or turn one on or off
#   omv theme [<name>]                    list themes, or switch to one
#   omv displays                          the display names a display profile's when can use
#   omv version                           the commit omv is at

# -E lets the ERR trap that offers undo reach into functions.
set -eEuo pipefail

REPO_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
readonly REPO_DIR
# shellcheck source=../install/packages.sh
source "$REPO_DIR/install/packages.sh"
# shellcheck source=../install/hammerspoon.sh
source "$REPO_DIR/install/hammerspoon.sh"
# shellcheck source=../install/aerospace.sh
source "$REPO_DIR/install/aerospace.sh"
# shellcheck source=../install/setup.sh
source "$REPO_DIR/install/setup.sh"
readonly STATE_DIR=$HOME/.local/state/omv
# The last update that moved omv: the commit before it, the one after it, and the migrations
# it ran. Kept until undo, so a retried or empty update doesn't lose the way back.
readonly UPDATE_FROM=$STATE_DIR/update-from
readonly UPDATE_TO=$STATE_DIR/update-to
readonly UPDATE_MIGRATIONS=$STATE_DIR/update-migrations
readonly MIGRATIONS_DONE=$STATE_DIR/migrations
readonly FLAGS_FILE=$HOME/.config/omv/flags
readonly OMV_FLAG_DEFAULTS=$REPO_DIR/config/hammerspoon/flags.lua
readonly OMV_FLAGS_FILE=$FLAGS_FILE
# shellcheck source=../config/sketchybar/.config/sketchybar/flags.sh
source "$REPO_DIR/config/sketchybar/.config/sketchybar/flags.sh"
# Ghostty can't read flags, so the ones it has are written as Ghostty settings here, which
# its config includes. Rewritten when a flag changes and on reload.
readonly GHOSTTY_FLAGS=$STATE_DIR/ghostty-flags
readonly THEMES_DIR=$HOME/.local/share/omv/themes
# hs -c can wait forever even with -t: a reload drops the call before it answers. So each
# call gets this long. 5 unless a test sets it.
readonly HS_SECONDS=${OMV_HS_SECONDS:-5}

usage() {
  sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  echo "usage: omv <install|update|doctor|uninstall|setup|reload|flags|theme|displays|version>" >&2
  exit 2
}

die() {
  echo "omv: $1" >&2
  exit 1
}

git_repo() {
  git -C "$REPO_DIR" "$@"
}

# Update and undo move the clone, so they only run on a clean main.
require_clean_main() {
  [ -z "$(git_repo status --porcelain)" ] || die "the omv folder has changes; commit or stash them first"
  [ "$(git_repo rev-parse --abbrev-ref HEAD)" = main ] || die "omv is not on main; switch to main first"
}

# hs, given up after HS_SECONDS.
hs_call() {
  perl -e "alarm $HS_SECONDS; exec @ARGV" hs "$@"
}

# hs -t ends the client cleanly when Hammerspoon is busy, rather than leaving it waiting.
reload_hammerspoon() {
  hs_call -t 3 -c 'hs.timer.doAfter(0.2, hs.reload)' >/dev/null 2>&1 || true
}

# Stow links files one by one, so a new file has no link until this runs again.
relink() {
  # First: it needs no link, so Hammerspoon keeps its config even when Stow stops below.
  point_hammerspoon
  mkdir -p "$HOME/.claude"
  stow --dir="$REPO_DIR/config" --target="$HOME" --restow "${CONFIG_PACKAGES[@]}"
  stow --dir="$REPO_DIR/agents" --target="$HOME" --restow "${AGENT_PACKAGES[@]}"
  # The other agents' plugins, as install links them: only for an agent set up here.
  if [ -d "$HOME/.config/opencode" ]; then
    mkdir -p "$HOME/.config/opencode/plugins"
    stow --dir="$REPO_DIR/agents" --target="$HOME" --restow opencode
  fi
  if [ -d "$HOME/.pi/agent" ]; then
    mkdir -p "$HOME/.pi/agent/extensions"
    stow --dir="$REPO_DIR/agents" --target="$HOME" --restow pi
  fi
  # A mistake in the user's file mustn't stop omv's own changes; the doctor names its line.
  build_aerospace || echo "omv: kept the old aerospace.toml; once the above is fixed, run omv reload" >&2
}

# Migrations first: Stow won't link over the links an older layout left behind.
install_in_terminal() {
  local argument
  for argument in "$@"; do
    if [ "$argument" = --dry-run ]; then
      echo "would run: pending migrations"
      "$REPO_DIR/install/install.sh" "$@"
      return
    fi
  done
  run_migrations
  "$REPO_DIR/install/install.sh" "$@"
}

# omv Setup runs the install itself, showing each step, then walks through the permissions.
# --no-setup, a dry run, or a Mac that can't build the app installs here, in the terminal.
install() {
  local argument arguments=() terminal=false
  for argument in "$@"; do
    case $argument in
      --no-setup) terminal=true ;;
      --dry-run) terminal=true; arguments+=("$argument") ;;
      --no-apps) arguments+=("$argument") ;;
      *) usage ;;
    esac
  done
  if ! $terminal; then refuse_when_setup_open || exit 1; fi
  if ! $terminal && build_setup_app; then
    open "$SETUP_APP" --args --install "$REPO_DIR" "${arguments[@]+"${arguments[@]}"}"
    echo "Continue in omv Setup: press Install to start."
    return 0
  fi
  if ! $terminal; then echo "omv: installing here in the terminal instead" >&2; fi
  install_in_terminal "${arguments[@]+"${arguments[@]}"}"
}

# After editing a file in ~/.config/omv: rebuild aerospace.toml, then reload what reads them.
# AeroSpace is asked only when it's running; it reads the file when it starts anyway.
reload_aerospace() {
  [ -n "$(pgrep -x AeroSpace 2>/dev/null || true)" ] || return 0
  aerospace reload-config
}

# When Hammerspoon last loaded omv's config (init.lua sets it), or nothing when it doesn't
# answer or predates that.
hammerspoon_loaded_at() {
  local answer
  answer=$(hs_call -t 1 -c 'return tostring(omvLoadedAt)' 2>/dev/null | tail -n 1 || true)
  [ "$answer" = nil ] || echo "$answer"
}

# hs.reload runs a moment after it's asked for, and Hammerspoon is silent while it reloads;
# the doctor would take that for a jam and restart it. So wait, up to 10 seconds, until the
# load time differs from $1, read before the reload. Nothing to wait for without one.
wait_for_hammerspoon() {
  [ -n "$1" ] || return 0
  local limit=$((SECONDS + 10)) now
  while [ "$SECONDS" -lt "$limit" ]; do
    now=$(hammerspoon_loaded_at)
    if [ -n "$now" ] && [ "$now" != "$1" ]; then return 0; fi
    sleep 0.3
  done
}

reload_all() {
  # Pending migrations first, as update runs them: one may still have to move a link away.
  run_migrations
  build_aerospace || die "aerospace.toml wasn't rebuilt; the old one stays"
  reload_aerospace || die "AeroSpace didn't accept the built aerospace.toml; see its message above"
  reload
  echo "reloaded"
}

reload() {
  write_ghostty_flags
  reload_hammerspoon
  sketchybar --reload >/dev/null 2>&1 || true
}

# Each script in migrations/ runs once, in name order (they start with a timestamp). One that
# fails stops the rest and isn't recorded, so the next update tries it again. With a file
# given, each one that ran is also listed there, so undo knows it can't reverse them.
run_migrations() {
  local script name also=${1:-}
  mkdir -p "$STATE_DIR"
  touch "$MIGRATIONS_DONE"
  for script in "$REPO_DIR"/migrations/*.sh; do
    [ -e "$script" ] || continue
    name=$(basename "$script" .sh)
    grep -qxF -- "$name" "$MIGRATIONS_DONE" && continue
    (cd "$REPO_DIR" && bash "$script") || die "migration $name failed; fix it, then run omv update again"
    echo "$name" >> "$MIGRATIONS_DONE"
    if [ -n "$also" ]; then echo "$name" >> "$also"; fi
  done
}

# Pulls, then hands over to the pulled omv, so the rest runs with the new packages list,
# migrations and code. The way back is saved only when the pull moved omv.
update() {
  require_clean_main
  mkdir -p "$STATE_DIR"
  local before after
  before=$(git_repo rev-parse HEAD)
  git_repo pull --ff-only || die "couldn't pull; nothing changed"
  after=$(git_repo rev-parse HEAD)
  if [ "$after" = "$before" ]; then exec "$REPO_DIR/bin/omv" update --finish; fi
  echo "$before" > "$UPDATE_FROM"
  echo "$after" > "$UPDATE_TO"
  : > "$UPDATE_MIGRATIONS"
  exec "$REPO_DIR/bin/omv" update --finish moved
}

offer_undo() {
  echo >&2
  # Undo can't reverse a migration, so after one the way out is forward.
  if [ -s "$UPDATE_MIGRATIONS" ]; then
    echo "The update stopped partway. Fix what it named above, then run omv update again" >&2
    return 0
  fi
  echo "The update stopped partway. To go back: omv update --undo" >&2
}

finish_update() {
  local record=
  if [ "${1:-}" = moved ]; then record=$UPDATE_MIGRATIONS; fi
  [ -s "$UPDATE_FROM" ] && trap offer_undo ERR
  # Migrations first: Stow won't link over the links an older layout left behind.
  run_migrations "$record"
  relink
  # Installs what's missing and upgrades nothing else: undo can't take an upgrade back.
  brew bundle --no-upgrade --file="$REPO_DIR/Brewfile"
  local loaded
  loaded=$(hammerspoon_loaded_at)
  reload
  reload_aerospace || echo "omv: AeroSpace didn't accept the built aerospace.toml; omv reload shows why" >&2
  trap - ERR
  wait_for_hammerspoon "$loaded"
  # --fix clears what an update can leave behind: a second bar, a SwipeAeroSpace that quit
  # while its config link was swapped, a stuck hs call.
  "$REPO_DIR/install/doctor.sh" --fix && return 0
  echo >&2
  echo "Something isn't right after the update. To fix what can be fixed: omv doctor --fix" >&2
  # Only when an update is saved: with none, undo has nowhere to go back to.
  [ -s "$UPDATE_FROM" ] && echo "To go back: omv update --undo" >&2
  exit 1
}

# Back to the commit before the last update, only when nothing would be lost: no changes,
# no commits since, and no migrations, which reset can't reverse.
undo() {
  [ -s "$UPDATE_FROM" ] || die "no update to undo"
  require_clean_main
  [ "$(git_repo rev-parse HEAD)" = "$(cat "$UPDATE_TO" 2>/dev/null)" ] \
    || die "omv has commits since the update; undo would drop them"
  if [ -s "$UPDATE_MIGRATIONS" ]; then
    die "this update ran migrations ($(tr '\n' ' ' < "$UPDATE_MIGRATIONS")), which undo can't reverse"
  fi
  git_repo reset --hard "$(cat "$UPDATE_FROM")"
  rm -f "$UPDATE_FROM" "$UPDATE_TO" "$UPDATE_MIGRATIONS"
  relink
  reload
}

write_ghostty_flags() {
  mkdir -p "$STATE_DIR"
  {
    echo "# Written by omv from its feature flags; omv flags changes them."
    omv_flag_on drop-down-terminal || echo 'keybind = global:alt+backquote=unbind'
    omv_flag_on long-command-notices || echo 'notify-on-command-finish = never'
  } > "$GHOSTTY_FLAGS"
}

flags() {
  local name default
  if [ "$#" -eq 0 ]; then
    while read -r name default; do echo "$name  $(omv_flag_value "$name" "$default")"; done < <(omv_flag_names)
    return 0
  fi
  [ "$#" -eq 2 ] || usage
  [[ $1 =~ ^[a-z][a-z0-9-]*$ ]] && omv_flag_names | cut -d' ' -f1 | grep -qxF -- "$1" \
    || die "no flag named $1; omv flags lists them"
  case $2 in on | off) ;; *) die "a flag is on or off, not $2" ;; esac
  mkdir -p "$(dirname "$FLAGS_FILE")"
  touch "$FLAGS_FILE"
  if grep -qE "^[[:space:]]*$1[[:space:]]*=" "$FLAGS_FILE"; then
    sed -i '' -E "s/^[[:space:]]*$1[[:space:]]*=.*/$1=$2/" "$FLAGS_FILE"
  else
    echo "$1=$2" >> "$FLAGS_FILE"
  fi
  write_ghostty_flags
  if flag_in_hammerspoon "$1"; then reload_hammerspoon; fi
  if flag_in_bar "$1"; then sketchybar --reload >/dev/null 2>&1 || true; fi
  echo "$1 is $2"
  if flag_in_ghostty "$1"; then echo "Ghostty applies it on its reload key, Cmd+Shift+Comma"; fi
}

# Whether Hammerspoon's config reads flag $1, outside the defaults: only then does it reload.
flag_in_hammerspoon() {
  grep -rqE --include='*.lua' --exclude=flags.lua -e "\"$1\"" -e "enabled\.$1([^a-z0-9_]|$)" \
    "$REPO_DIR/config/hammerspoon"
}

# Whether the bar adds an item only with flag $1: only then does it reload.
flag_in_bar() {
  grep -qE "omv_flag_on $1( |;|$)" "$REPO_DIR/config/sketchybar/.config/sketchybar/sketchybarrc" 2>/dev/null
}

flag_in_ghostty() {
  declare -f write_ghostty_flags | grep -qF "omv_flag_on $1 "
}

theme_names() {
  local folder
  {
    echo vantablack
    for folder in "$THEMES_DIR"/*/; do
      if [ -f "$folder/colors.toml" ]; then basename "$folder"; fi
    done
  } | sort -u
}

theme() {
  if [ "$#" -eq 0 ]; then theme_names; return 0; fi
  # A plain name only, as the theme card reads them: it goes into Lua below.
  [[ $1 =~ ^[A-Za-z0-9-]+$ ]] && theme_names | grep -qxF -- "$1" || die "no theme named $1; omv theme lists them"
  hs_call -t 5 -c "omvSetTheme(\"$1\")" >/dev/null || die "Hammerspoon didn't answer; is it running?"
  echo "theme: $1"
}

command=${1:-}
[ -n "$command" ] || usage
shift
case $command in
  install) install "$@" ;;
  update)
    case ${1:-} in
      '') update ;;
      --undo) [ "$#" -eq 1 ] || usage; undo ;;
      --finish) finish_update "${2:-}" ;;
      *) usage ;;
    esac
    ;;
  doctor) "$REPO_DIR/install/doctor.sh" "$@" ;;
  uninstall) "$REPO_DIR/install/uninstall.sh" "$@" ;;
  reload)
    case $# in
      0) reload_all ;;
      # The pins or gaps for the screens plugged in changed: only AeroSpace needs them, and
      # Hammerspoon asks.
      # AeroSpace reloads only when the built file changed: a reload lays out every window again.
      1) [ "$1" = aerospace ] || usage
         before=$(cat "$AEROSPACE_BUILT" 2>/dev/null || true)
         build_aerospace || die "aerospace.toml wasn't rebuilt; the old one stays"
         [ "$before" != "$(cat "$AEROSPACE_BUILT")" ] || exit 0
         reload_aerospace || die "AeroSpace didn't accept the built aerospace.toml; see its message above" ;;
      *) usage ;;
    esac
    ;;
  setup) [ "$#" -eq 0 ] || usage; open_setup_app || exit 1 ;;
  flags) flags "$@" ;;
  theme) theme "$@" ;;
  displays)
    [ "$#" -eq 0 ] || usage
    (cd "$REPO_DIR/config/hammerspoon" && luajit workspaces.lua names "$HOME/.local/state/omv/displays-seen")
    printf '\nIn ~/.config/omv/workspaces, on and [screen NAME] name screens: laptop, and part of each name.\n' ;;
  version) echo "omv $(git_repo log -1 '--format=%h %cs')" ;;
  *) usage ;;
esac
